/target

# Generated by scripts/sbom.sh; the SBOM is published with a release, not committed.
*.cdx.json

# cargo-fuzz working state. The corpus and the crashing inputs are outputs of a
# run, not source; a crash worth keeping becomes a test case in the suite rather
# than a binary blob in the history.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/Cargo.lock
