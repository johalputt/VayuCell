// SPDX-License-Identifier: Apache-2.0
//
// Every rule disabled below carries the reason it is disabled. A lint config
// full of bare rule numbers is a config nobody can safely re-enable, because
// nothing records whether the rule was wrong or the document was.
{
  "config": {
    // MD013 line length. Prose here argues; it is not reference material set to
    // a house column width. Left to the author.
    "MD013": false,

    // MD024 duplicate headings. The ADRs deliberately reuse section names —
    // "Open decisions", "What this will never claim" — so the same question is
    // findable in the same place in each one. Still enforced among siblings.
    "MD024": { "siblings_only": true },

    // MD033 inline HTML. Used for the SPDX comment at the top of each document.
    "MD033": false,

    // MD036 emphasis used instead of a heading. CHARTER.md and
    // GOVERNANCE-CONSTITUTION.md open with a bold subtitle line under their H1
    // carrying the version and licence. That is a subtitle, not a section, and
    // promoting it to a real heading would put "Version 1.0" into the document
    // outline as though it were a chapter.
    "MD036": false,

    // MD041 first line must be a top-level heading. Enforced everywhere except
    // .github/, and enforced more strictly than markdownlint can manage by
    // scripts/docs-gate.sh, which additionally requires each ADR's H1 to name
    // the same number as its filename.
    "MD041": true
  },
  "globs": ["**/*.md"],
  "ignores": [
    "target/**",
    ".git/**",
    "node_modules/**",
    // GitHub renders pull_request_template.md into the body of a pull request.
    // Its first line is a section of that body, not the title of a document, and
    // an H1 there would render as a heading inside every pull request.
    ".github/**"
  ]
}
